# 135er-Grow Central alpha-0.7.1 example configuration
# Never commit production secrets.

# DF100M reverse-engineering candidates; not yet validated.
DF100M_NAME_HINT=MZ_MZF002
DF100M_WRITE_UUID=f5d2b3fe-e6b5-49b5-aa5f-a00bb4156d1d
DF100M_NOTIFY_UUID=83677baa-3eb8-4866-b6b6-96e5ed5cc48d
DF100M_SPEED_MODE=byte
DF100M_ALLOW_WRITES=false
DF100M_ALLOW_RAW_WRITES=false

# Local write authentication. Empty means protected writes are unavailable.
GC_LOCAL_API_TOKEN=

# Optional smart-home subsystem. Safe defaults keep writes disabled.
GC_SMARTHOME_ENABLED=false
GC_SMARTHOME_DEVICE_CONFIG=/etc/135er-grow-central/devices.json
GC_HA_URL=http://homeassistant.local:8123
GC_HA_TOKEN=
GC_HA_READ_ONLY=true

# Optional cloud link.
GC_CLOUD_ENABLED=false
GC_REMOTE_COMMANDS=false
