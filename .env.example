# 135er-Grow Central alpha-0.7.1 example configuration
# Never commit production secrets.

# DF100M reverse-engineering candidates; not yet validated.
DF100M_NAME_HINT=MZ_MZF002
DF100M_WRITE_UUID=f5d2b3fe-e6b5-49b5-aa5f-a00bb4156d1d
DF100M_NOTIFY_UUID=83677baa-3eb8-4866-b6b6-96e5ed5cc48d
DF100M_SPEED_MODE=byte
DF100M_ALLOW_WRITES=false
DF100M_ALLOW_RAW_WRITES=false

# Local write authentication. Empty means protected writes are unavailable.
GC_LOCAL_API_TOKEN=

# Optional smart-home subsystem. Safe defaults keep writes disabled.
GC_SMARTHOME_ENABLED=false
GC_SMARTHOME_DEVICE_CONFIG=/etc/135er-grow-central/devices.json
GC_HA_URL=http://homeassistant.local:8123
GC_HA_TOKEN=
GC_HA_READ_ONLY=true

# Optional cloud link.
GC_CLOUD_ENABLED=false
GC_REMOTE_COMMANDS=false

# Native Grow-Central ESP32 / MQTT. The Pi image provides a local broker on 1883.
# Backend uses loopback; ESP32 nodes connect to the Pi's private-LAN address.
GC_MQTT_HOST=127.0.0.1
GC_MQTT_PORT=1883
GC_MQTT_PREFIX=growcentral/v1
GC_MQTT_USERNAME=
GC_MQTT_PASSWORD=
GC_MQTT_COMMAND_TIMEOUT=5

# Native sensor trust decisions; keep this state across upgrades.
GC_DEVICE_TRUST_DB=/var/lib/135er-grow-central/device-trust.db
# Local backend uses loopback MQTT. For a TLS broker configure its real CA and
# GC_MQTT_USERNAME/GC_MQTT_PASSWORD privately; never put passwords into commits.
GC_MQTT_TLS=false
# GC_MQTT_CA_FILE=/etc/mosquitto/certs/grow-central-ca.crt
# BLE credential transfer is not implemented; never send Wi-Fi credentials via MQTT.

# Scoped export to Home Assistant (disabled until explicitly configured).
GC_HA_EXPORT_ENABLED=false
# Separate random >=32-character secret; never reuse the administrator API token.
GC_HA_BRIDGE_TOKEN=
# Comma-separated approved device IDs, e.g. lamp,growcentral_esp32:gc-soil-aabbcc
GC_HA_EXPORT_DEVICE_IDS=
# Additional opt-in for switches; also requires approved+writable+GC_SMARTHOME_ENABLED.
GC_HA_EXPORT_SWITCH_IDS=

# Guided USB setup uses the image's checked firmware and local privileged broker helper.
# Optional development overrides (not browser-configurable):
# GC_USB_FIRMWARE_DIR=/opt/135er-grow-central/firmware/gc-soil-node/dist
# GC_PROVISIONING_SOCKET=/run/grow-central-provisioning/broker.sock
