[Unit]
Description=135er GrowControl Test
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/135er-growcontrol-test
EnvironmentFile=/opt/135er-growcontrol-test/.env
ExecStart=/opt/135er-growcontrol-test/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
