# DE: Cloud-Dienst.
# EN: Cloud service.
CLOUD_HOST=127.0.0.1
CLOUD_PORT=8090
CLOUD_DB=./data/cloud.db

# DE: Vor Deployment ändern.
# EN: Change before deployment.
CLOUD_API_TOKEN=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS

# DE/EN: Remote commands off by default / standardmäßig aus.
CLOUD_ALLOW_COMMANDS=false
