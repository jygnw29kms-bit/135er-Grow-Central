# Copy to backoffice/.env on the server. Never commit real secrets.
POSTGRES_DB=growcentral_backoffice
POSTGRES_USER=growcentral_backoffice
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
GC_BACKOFFICE_DB=Host=grow-central-backoffice-db;Port=5432;Database=growcentral_backoffice;Username=growcentral_backoffice;Password=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

# Nur für die erstmalige Owner-Anlage. Nach erfolgreichem Bootstrap nicht als normale API-Authentifizierung verwendbar.
GC_BACKOFFICE_BOOTSTRAP_TOKEN=CHANGE_ME_AT_LEAST_48_RANDOM_CHARACTERS

# 32 zufällige Bytes, Base64-kodiert. Verschlüsselt serverseitig MFA-Secrets. Niemals verlieren oder ins Repo committen.
GC_BACKOFFICE_SECRET_KEY=CHANGE_ME_BASE64_ENCODED_32_RANDOM_BYTES

# Unveränderbare Originalbelege. Eigenes persistentes Docker-Volume, nicht das Telemetrie-/SQLite-Volume.
GC_BACKOFFICE_STORAGE_ROOT=/data/backoffice
