        {"id":"germination","title":"Keimen","todos":["Samen in feuchtes Anzuchtsubstrat säen","Substrat gleichmäßig feucht halten","Keimtemperatur überwachen"],"targets":{"temperature_c":"18–21","moisture":"gleichmäßig feucht, nicht nass"}},
