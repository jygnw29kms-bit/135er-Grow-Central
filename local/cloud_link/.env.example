# DE: Cloud erst nach VServer-Einrichtung aktivieren.
# EN: Enable cloud only after VPS setup.
GC_CLOUD_ENABLED=false
GC_CLOUD_URL=https://grow.example.de
GC_CLOUD_TOKEN=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
GC_SITE_ID=garage
GC_SYNC_SECONDS=30

# DE: Zweite Sicherheitsfreigabe für Remote-Befehle.
# EN: Second security opt-in for remote commands.
GC_REMOTE_COMMANDS=false
GC_LOCAL_API=http://127.0.0.1:8080
GC_LOCAL_API_TOKEN=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
