[Unit]
Description=135er GrowControl Cloud Link
After=network-online.target 135er-growcontrol.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/135er-growcontrol/local/cloud_link
EnvironmentFile=/opt/135er-growcontrol/local/cloud_link/.env
ExecStart=/opt/135er-growcontrol/.venv/bin/python /opt/135er-growcontrol/local/cloud_link/agent.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
