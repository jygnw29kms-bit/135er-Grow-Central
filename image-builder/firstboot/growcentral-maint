#!/bin/bash
set -euo pipefail

CORE=135er-grow-central.service
CLOUD=135er-grow-central-cloud-link.service
HOMEKIT=grow-central-homekit.service
APP_ROOT=/opt/135er-grow-central
STATE_ROOT=/var/lib/135er-grow-central
STAGE_ROOT="$STATE_ROOT/maintenance/staged"
BACKUP_ROOT="$STATE_ROOT/maintenance/backups"
MAX_FILES=500
MAX_BYTES=$((50 * 1024 * 1024))

usage() {
  echo "usage: growcentral-maint {status|restart-core|restart-cloud|restart-homekit|restart-all|apply-staged}" >&2
  exit 64
}

die() {
  echo "growcentral-maint: $*" >&2
  exit 1
}

state() {
  local unit="$1"
  systemctl is-active "$unit" 2>/dev/null || true
}

health_core() {
  curl --fail --silent --show-error --max-time 12 http://127.0.0.1:8080/api/health \
    | jq -e '.ok == true and .service == "135er-Grow Central Local"' >/dev/null
}

restart_unit() {
  local unit="$1"
  systemctl reset-failed "$unit" >/dev/null 2>&1 || true
  systemctl restart "$unit"
  systemctl is-active --quiet "$unit"
}

safe_relative_path() {
  local rel="$1" part ext
  [[ "$rel" != /* && "$rel" != *\\* ]] || return 1
  case "$rel" in
    app/*|local/cloud_link/*|web/*|shared/*) ;;
    *) return 1 ;;
  esac
  [[ "${rel##*/}" != "requirements.txt" ]] || return 1
  IFS='/' read -r -a parts <<<"$rel"
  for part in "${parts[@]}"; do
    [[ -n "$part" && "$part" != "." && "$part" != ".." && "$part" != .* ]] || return 1
  done
  ext="${rel##*.}"
  case "$ext" in
    py|json|html|js|css|svg|png|webp|jpg|jpeg|ico|txt|md|toml|yaml|yml) return 0 ;;
    *) return 1 ;;
  esac
}

validate_stage() {
  local manifest="$STAGE_ROOT/MANIFEST" sums="$STAGE_ROOT/SHA256SUMS" payload="$STAGE_ROOT/payload"
  [[ -f "$manifest" && ! -L "$manifest" ]] || die "staged MANIFEST missing"
  [[ -f "$sums" && ! -L "$sums" ]] || die "staged SHA256SUMS missing"
  [[ -d "$payload" && ! -L "$payload" ]] || die "staged payload missing"
  ! find "$payload" -type l -print -quit | grep -q . || die "staged payload contains symlinks"

  local commit count listed_count size hash rel extra
  commit="$(sed -n 's/^commit=\([0-9a-f]\{40\}\)$/\1/p' "$manifest" | head -n1)"
  [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || die "invalid staged commit"
  count="$(find "$payload" -type f | wc -l)"
  [[ "$count" -ge 1 && "$count" -le "$MAX_FILES" ]] || die "staged file count out of bounds"
  size="$(du -sb "$payload" | awk '{print $1}')"
  [[ "$size" -le "$MAX_BYTES" ]] || die "staged payload exceeds size limit"

  listed_count=0
  while read -r hash rel extra; do
    [[ -z "${extra:-}" ]] || die "invalid checksum line"
    [[ "$hash" =~ ^[0-9a-f]{64}$ ]] || die "invalid checksum"
    safe_relative_path "$rel" || die "unsafe staged path: $rel"
    [[ -f "$payload/$rel" && ! -L "$payload/$rel" ]] || die "manifest file missing: $rel"
    listed_count=$((listed_count + 1))
  done < "$sums"
  [[ "$listed_count" -eq "$count" ]] || die "manifest/file count mismatch"
  (cd "$payload" && sha256sum -c ../SHA256SUMS >/dev/null) || die "staged checksum verification failed"

  rm -rf /tmp/growcentral-maint-pyc
  local compile_paths=()
  [[ -d "$payload/app" ]] && compile_paths+=("$payload/app")
  [[ -d "$payload/local" ]] && compile_paths+=("$payload/local")
  [[ -d "$payload/shared" ]] && compile_paths+=("$payload/shared")
  if [[ "${#compile_paths[@]}" -gt 0 ]]; then
    PYTHONPYCACHEPREFIX=/tmp/growcentral-maint-pyc "$APP_ROOT/.venv/bin/python" -m compileall -q "${compile_paths[@]}" \
      || die "staged Python compile failed"
  fi
  rm -rf /tmp/growcentral-maint-pyc
  printf '%s\n' "$commit"
}

copy_payload() {
  local source_root="$1" target_root="$2" sums="$3" hash rel extra parent_real
  while read -r hash rel extra; do
    parent_real="$(realpath -e "$target_root/$(dirname "$rel")")" || die "target parent missing: $rel"
    case "$parent_real/" in
      "$target_root"/*/) ;;
      *) die "target parent escapes app root: $rel" ;;
    esac
    [[ ! -L "$target_root/$rel" ]] || die "target is symlink: $rel"
    install -o root -g growcentral -m 0644 "$source_root/$rel" "$target_root/$rel"
  done < "$sums"
}

backup_live() {
  local backup="$1" sums="$2" hash rel extra target
  mkdir -p "$backup/files"
  : > "$backup/created.list"
  while read -r hash rel extra; do
    target="$APP_ROOT/$rel"
    if [[ -e "$target" ]]; then
      mkdir -p "$backup/files/$(dirname "$rel")"
      cp -a --no-dereference "$target" "$backup/files/$rel"
    else
      printf '%s\n' "$rel" >> "$backup/created.list"
    fi
  done < "$sums"
  cp -a "$STAGE_ROOT/MANIFEST" "$STAGE_ROOT/SHA256SUMS" "$backup/"
}

rollback_live() {
  local backup="$1" rel
  set +e
  systemctl stop "$HOMEKIT" "$CLOUD" "$CORE"
  if [[ -d "$backup/files" ]]; then
    (cd "$backup/files" && find . -type f -print0) | while IFS= read -r -d '' rel; do
      rel="${rel#./}"
      install -o root -g growcentral -m 0644 "$backup/files/$rel" "$APP_ROOT/$rel"
    done
  fi
  if [[ -f "$backup/created.list" ]]; then
    while IFS= read -r rel; do
      [[ -n "$rel" ]] && rm -f "$APP_ROOT/$rel"
    done < "$backup/created.list"
  fi
  systemctl start "$CORE"
  sleep 2
  systemctl start "$CLOUD" "$HOMEKIT"
  set -e
}

apply_staged() {
  local commit stamp backup sums="$STAGE_ROOT/SHA256SUMS"
  commit="$(validate_stage)"
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  backup="$BACKUP_ROOT/${stamp}-${commit:0:12}"
  mkdir -p "$BACKUP_ROOT"
  backup_live "$backup" "$sums"

  trap 'rollback_live "$backup"' ERR INT TERM
  systemctl stop "$HOMEKIT" "$CLOUD" "$CORE"
  copy_payload "$STAGE_ROOT/payload" "$APP_ROOT" "$sums"
  systemctl start "$CORE"
  sleep 2
  health_core
  systemctl start "$CLOUD" "$HOMEKIT"
  systemctl is-active --quiet "$CLOUD"
  systemctl is-active --quiet "$HOMEKIT"
  printf '%s\n' "$commit" > "$APP_ROOT/.live-git-sha"
  chown root:growcentral "$APP_ROOT/.live-git-sha"
  chmod 0644 "$APP_ROOT/.live-git-sha"
  trap - ERR INT TERM

  rm -rf "$STAGE_ROOT/payload"
  rm -f "$STAGE_ROOT/MANIFEST" "$STAGE_ROOT/SHA256SUMS"
  find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' \
    | sort -nr | tail -n +11 | cut -d' ' -f2- | xargs -r rm -rf --
  echo "applied=$commit"
  echo "backup=$backup"
}

case "${1:-}" in
  status)
    printf 'core=%s\n' "$(state "$CORE")"
    printf 'cloud=%s\n' "$(state "$CLOUD")"
    printf 'homekit=%s\n' "$(state "$HOMEKIT")"
    printf 'live_git_sha=%s\n' "$(cat "$APP_ROOT/.live-git-sha" 2>/dev/null || true)"
    ;;
  restart-core)
    restart_unit "$CORE"
    sleep 2
    health_core
    ;;
  restart-cloud)
    restart_unit "$CLOUD"
    ;;
  restart-homekit)
    restart_unit "$HOMEKIT"
    ;;
  restart-all)
    restart_unit "$CORE"
    sleep 2
    health_core
    restart_unit "$CLOUD"
    restart_unit "$HOMEKIT"
    ;;
  apply-staged)
    apply_staged
    ;;
  *) usage ;;
esac
