[Unit]
Description=135er-Grow Central Elecrow 7-inch local touch GUI
After=network-online.target 135er-grow-central.service
Wants=network-online.target 135er-grow-central.service
ConditionPathExists=/var/lib/135er-grow-central/display-mode

[Service]
Type=simple
ExecStart=/opt/135er-grow-central/image-builder/firstboot/display-kiosk.sh
Restart=always
RestartSec=8
TimeoutStartSec=0
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
