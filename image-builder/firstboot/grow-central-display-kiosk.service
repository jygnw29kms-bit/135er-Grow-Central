[Unit]
Description=135er-Grow Central local touch GUI
After=135er-grow-central.service systemd-user-sessions.service
Wants=135er-grow-central.service
ConditionPathExists=/var/lib/135er-grow-central/display-mode
Conflicts=getty@tty1.service

[Service]
Type=simple
TTYPath=/dev/tty1
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
ExecStart=/opt/135er-grow-central/image-builder/firstboot/display-kiosk.sh
Restart=always
RestartSec=5
TimeoutStartSec=0
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
